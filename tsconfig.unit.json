{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "./temp/unit-tests",
    "noEmit": false,
    "incremental": false,
    "isolatedModules": false,
    "types": ["node"]
  },
  "include": ["src/**/*.test.ts"],
  "exclude": ["node_modules", ".next", "temp"]
}
