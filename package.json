{
  "name": "elpepesetch-fullstack-multimedia-app-front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "tsc -p tsconfig.unit.json && node --test \"temp/unit-tests/src/**/*.test.js\"",
    "lint:clean": "eslint -c eslint.clean.config.mjs src app && node .claude/skills/clean-feature/scripts/clean-audit.mjs",
    "inventory:clean": "node .claude/skills/clean-feature/scripts/inventory.mjs",
    "diagram:clean": "node .claude/skills/clean-feature/scripts/diagram.mjs",
    "test:e2e": "playwright test",
    "test:library:unit": "node tests/run-library-unit.mjs",
    "test:e2e:graphql": "node e2e/run.mjs graphql",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^1.80.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "^9.3.0",
    "server-only": "^0.0.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "daisyui": "^5.8.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0"
  }
}
